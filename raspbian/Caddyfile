# TacticalFrog web front end. Loaded by raspbian/caddy.service; after editing, apply with (no sudo needed)
#   caddy reload --config /opt/TacticalFrog/current/raspbian/Caddyfile
#
# HTTP only. There's no public domain (and no internet in access-point mode), so HTTPS could only use a
# self-signed/local-CA certificate, which makes every browser show a security warning. Not listening on
# 443 at all means https:// attempts fail fast and browsers fall back to http://.
# (To bring HTTPS back: add a ":443 { tls internal { on_demand } import tacticalfrog }" site; the pages already
# switch to wss:// for rosbridge when loaded over https.)

(tacticalfrog) {
	@api path_regexp apy ^(/|/api/.*|/download/.*|/viewer/.*|/model/.*|/wifi/.*)$

	# read-only browsable listing of all recordings and models (also shared over SMB, see smb.conf)
	redir /files /files/
	handle_path /files/* {
		root * /data/trips
		file_server browse
	}

	# connect up the video server
	handle_path /vid* {
		reverse_proxy localhost:8080
	}

	# rosbridge websocket, so pages served over HTTPS can reach it as wss://<host>/rosbridge
	handle_path /rosbridge* {
		reverse_proxy localhost:9090
	}

	handle @api {
		reverse_proxy localhost:5000
	}

	# Everything else is static, from www/
	handle {
		root * /opt/TacticalFrog/current/www/
		file_server
	}

	log {
		output file /var/log/caddy/access.log
		format json
	}
}

:80 {
	import tacticalfrog
}
