# Cyclops web front end. Loaded by raspbian/caddy.service; after editing, apply with (no sudo needed)
#   caddy reload --config /home/pi/Cyclops/raspbian/Caddyfile
#
# Served on both HTTP and HTTPS. There's no public domain (and no internet in access-point mode), so HTTPS
# uses Caddy's own local certificate authority, issuing a certificate on demand for whichever hostname or
# IP the device is reached by. Browsers will warn until they trust that CA's root certificate, which is at
# /var/lib/caddy/.local/share/caddy/pki/authorities/local/root.crt

(cyclops) {
	#  Match all under ply
	@ply path_regexp ply ^/ply/(.+)$
	@api path_regexp apy ^(/|/api/.*|/download/.*|/viewer/.*|/model/.*|/wifi/.*)$

	handle @ply {
		# Serve PLY files from /data, not from site root
		root * /data
		rewrite * /{http.regexp.ply.1}
		file_server
	}

	# connect up the video server
	handle_path /vid* {
		reverse_proxy localhost:8080
	}

	# rosbridge websocket, so pages served over HTTPS can reach it as wss://<host>/rosbridge
	handle_path /rosbridge* {
		reverse_proxy localhost:9090
	}

	handle @api {
		reverse_proxy localhost:5000
	}

	# Everything else is static, from www/
	handle {
		root * /home/pi/Cyclops/www/
		file_server
	}

	log {
		output file /var/log/caddy/access.log
		format json
	}
}

:80 {
	import cyclops
}

:443 {
	tls internal {
		on_demand
	}
	import cyclops
}
