[Unit]
Description=ROS2 launch for tactical_frog/all.yaml
After=network.target

[Service]
Type=simple
User=pi
Group=pi
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/pi/.local/bin/
#Environment=ROS_DOMAIN_ID=0
#Environment="RMW_IMPLEMENTATION=rmw_fastrtps_cpp"
WorkingDirectory=/home/pi
# ros_env.sh sources ROS 2, the workspace and /opt/orb_slam3/current
ExecStart=/opt/TacticalFrog/current/raspbian/ros_env.sh ros2 launch tactical_frog all.yaml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
